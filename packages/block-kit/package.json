{
  "name": "@usewaypoint/block-kit",
  "version": "0.0.1",
  "description": "Shared schemas and helpers for @usewaypoint/block-* packages",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --outDir dist --format cjs,esm --dts"
  },
  "author": "carlos@usewaypoint.com",
  "license": "MIT",
  "dependencies": {
    "insane": "^2.6.2"
  },
  "peerDependencies": {
    "react": "^16 || ^17 || ^18",
    "zod": "^1 || ^2 || ^3"
  },
  "devDependencies": {
    "@types/insane": "^1.0.0"
  }
}
